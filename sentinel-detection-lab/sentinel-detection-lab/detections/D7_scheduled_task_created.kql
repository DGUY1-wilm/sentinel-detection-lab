// Detection: D7 Scheduled task created
// ATT&CK: T1053.005 (Persistence/Execution - Scheduled Task)
// Data source: SecurityEvent, EventID 4698 (needs "Other Object Access Events" auditing)
// Hypothesis: attackers use scheduled tasks to persist or run code later
// False positives: Windows and software updaters create tasks constantly
// Tuning: uncomment the Microsoft path exclusion, allowlist known software task names
// Note: if TaskName comes back empty, run:
//   SecurityEvent | where EventID == 4698 | take 1 | project EventData
// and check how the XML is formatted
let lookback = 24h;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4698
| extend TaskName = extract(@'<Data Name="TaskName">([^<]+)</Data>', 1, EventData)
// | where TaskName !startswith @'\Microsoft\Windows\'
| project TimeGenerated, Computer, TaskName, CreatedBy = SubjectUserName, CreatedByDomain = SubjectDomainName
| sort by TimeGenerated desc
