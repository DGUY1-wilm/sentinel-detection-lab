// Detection: D4 Encoded PowerShell command
// ATT&CK: T1059.001 (Execution - PowerShell)
// Data source: SecurityEvent, EventID 4688 (process creation, command line auditing must be on)
// Hypothesis: attackers hide commands in base64 using -EncodedCommand
// False positives: some management and deployment tools legitimately use encoded commands
// Tuning: allowlist by ParentProcessName or known admin accounts
let lookback = 24h;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4688
| where NewProcessName has_any ("powershell.exe", "pwsh.exe")
| where CommandLine matches regex @'(?i)\s-(e|en|enc|enco|encod|encode|encoded|encodedc\w*)\s+[A-Za-z0-9+/=]{20,}'
| project TimeGenerated, Computer, Account, NewProcessName, ParentProcessName, CommandLine
| sort by TimeGenerated desc
