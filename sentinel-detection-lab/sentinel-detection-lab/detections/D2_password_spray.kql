// Detection: D2 Password spray
// ATT&CK: T1110.003 (Credential Access - Password Spraying)
// Data source: SecurityEvent, EventID 4625 (failed logon)
// Hypothesis: one source trying a few passwords against many different accounts
// False positives: vulnerability scanners, misconfigured apps retrying with many identities
// Tuning: allowlist scanner IPs, raise minAccounts, widen the window
let lookback = 24h;
let window = 10m;
let minAccounts = 5;
let maxAttemptsPerAccount = 3;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4625
| summarize DistinctAccounts = dcount(TargetUserName),
            Accounts = make_set(TargetUserName, 20),
            Attempts = count(),
            FirstSeen = min(TimeGenerated),
            LastSeen = max(TimeGenerated)
    by IpAddress, Computer, bin(TimeGenerated, window)
| extend AvgAttemptsPerAccount = round(todouble(Attempts) / DistinctAccounts, 1)
| where DistinctAccounts >= minAccounts and AvgAttemptsPerAccount <= maxAttemptsPerAccount
| sort by DistinctAccounts desc
