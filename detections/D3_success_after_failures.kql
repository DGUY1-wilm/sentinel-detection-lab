// Detection: D3 Successful logon after repeated failures
// ATT&CK: T1110 (Brute Force) leading to T1078 (Valid Accounts)
// Data source: SecurityEvent, EventID 4625 (failure) then 4624 (success)
// Hypothesis: a login that succeeds right after a burst of failures suggests the guess worked
// False positives: a user who forgot their password and then remembered it
// Tuning: raise minFailures, exclude accounts that routinely lock out, require a new source IP
let lookback = 24h;
let window = 10m;        // how soon after the last failure a success counts
let minFailures = 5;
let failures = SecurityEvent
    | where TimeGenerated > ago(lookback)
    | where EventID == 4625
    | summarize FailureCount = count(), LastFailure = max(TimeGenerated) by TargetUserName, Computer
    | where FailureCount >= minFailures;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4624 and LogonType in (3, 10)   // 3 = network, 10 = remote interactive (RDP)
| join kind=inner failures on TargetUserName, Computer
| where TimeGenerated between (LastFailure .. LastFailure + window)
| project SuccessTime = TimeGenerated, TargetUserName, Computer, IpAddress, LogonType, FailureCount, LastFailure
| sort by SuccessTime desc
