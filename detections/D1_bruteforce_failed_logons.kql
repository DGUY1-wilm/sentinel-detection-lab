// Detection: D1 Brute-force failed logons
// ATT&CK: T1110.001 (Credential Access - Password Guessing)
// Data source: SecurityEvent, EventID 4625 (failed logon)
// Hypothesis: many failed logons against one account in a short window is password guessing
// False positives: users mistyping passwords, service accounts with expired credentials
// Tuning: raise the threshold, exclude known service accounts, exclude known scanner IPs
let lookback = 24h;   // testing in the Logs page; in the analytics rule match the rule's lookup period
let window = 5m;
let threshold = 5;
SecurityEvent
| where TimeGenerated > ago(lookback)
| where EventID == 4625
| summarize FailedCount = count(),
            FirstFailure = min(TimeGenerated),
            LastFailure = max(TimeGenerated),
            SourceIPs = make_set(IpAddress, 10)
    by TargetAccount, Computer, bin(TimeGenerated, window)
| where FailedCount >= threshold
| sort by FailedCount desc
